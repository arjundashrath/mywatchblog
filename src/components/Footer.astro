---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p class="tagline">All Things Watches in India</p>
		<p class="social-links">
			<a href="https://www.reddit.com/r/thewristjournal/" target="_blank" rel="noopener noreferrer">r/thewristjournal</a>
			<span class="sep">&middot;</span>
			<a href="https://www.instagram.com/_thewristjournal_/" target="_blank" rel="noopener noreferrer">Instagram</a>
			<span class="sep">&middot;</span>
			<a href="https://amzn.in/d/02rgcsOR" target="_blank" rel="noopener noreferrer">Amazon Storefront</a>
		</p>
		<p class="footer-links">
			<a href="/about">About</a>
			<span class="sep">&middot;</span>
			<a href="/contact">Contact</a>
			<span class="sep">&middot;</span>
			<a href="/editorial-policy">Editorial Policy</a>
			<span class="sep">&middot;</span>
			<a href="/affiliate-disclosure">Affiliate Disclosure</a>
			<span class="sep">&middot;</span>
			<a href="/privacy">Privacy Policy</a>
		</p>
		<p class="copyright">
			&copy; {today.getFullYear()} The Wrist Journal. All rights reserved.
		</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 3em 1.5em;
		text-align: center;
		background-color: var(--bg-subtle);
	}

	.footer-content {
		max-width: 960px;
		margin: 0 auto;
	}

	.tagline {
		font-family: "Space Grotesk", sans-serif;
		font-size: 1.1rem;
		font-weight: 500;
		color: var(--text-secondary);
		margin: 0 0 0.5em 0;
	}

	.social-links,
	.footer-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5em;
		flex-wrap: wrap;
	}

	.social-links {
		font-size: 0.9rem;
		margin: 0.75em 0;
	}

	.social-links a {
		color: var(--text-secondary);
		text-decoration: none;
		font-weight: 500;
		transition: color var(--transition);
	}

	.social-links a:hover {
		color: var(--accent);
	}

	.sep {
		color: var(--text-muted);
	}

	.footer-links {
		font-size: 0.85rem;
		margin: 0.75em 0;
	}

	.footer-links a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color var(--transition);
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.copyright {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin: 0;
	}
</style>
