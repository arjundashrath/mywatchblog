---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { categoryLabels, priceLabels } from "../utils/taxonomy";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const posts = allPosts.slice(0, 3);
const preferred = ["what-makes-a-good-watch", "best-watches-under-10k", "which-gshock-to-buy-part-1"];
const startHere = preferred.map((id) => allPosts.find((post) => post.id === id)).filter(Boolean).slice(0, 3);
---

<!DOCTYPE html>
<html lang="en-IN">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <p class="hero-eyebrow">The Premier Guide to</p>
        <h1>The Wrist Journal: Watches in India</h1>
        <p class="hero-subtitle">Watch reviews, buying guides and horology stories built around what actually matters to Indian collectors.</p>
        <div class="hero-actions">
          <a href="/blog/" class="cta-button">Explore all articles</a>
          <a href="/blog/#article-search" class="secondary-link">Search the journal →</a>
        </div>
      </section>

      <section class="discovery-section">
        <div class="section-heading">
          <div><p class="section-eyebrow">Shop by budget</p><h2>What are you looking to spend?</h2></div>
          <p>Start with a budget and find guides and reviews that make sense for it.</p>
        </div>
        <div class="budget-grid">
          {Object.entries(priceLabels).filter(([key]) => key !== "all-prices").map(([key, label]) => (
            <a class="discovery-card" href={`/blog/?price=${key}`}><span>{label}</span><small>Browse watches →</small></a>
          ))}
        </div>
      </section>

      <section class="discovery-section compact">
        <div class="section-heading"><div><p class="section-eyebrow">Browse by intent</p><h2>Read what you came for</h2></div></div>
        <div class="category-grid">
          {Object.entries(categoryLabels).map(([key, label]) => (
            <a class="category-card" href={`/category/${key}/`}><strong>{label}</strong><span>Explore →</span></a>
          ))}
        </div>
      </section>

      {posts.length > 0 && (
        <section class="latest-posts">
          <div class="section-heading"><div><p class="section-eyebrow">Fresh from the journal</p><h2>Latest Watch Reviews & Guides</h2></div><a href="/blog/">View all →</a></div>
          <div class="posts-grid">
            {posts.map((post) => (
              <a href={`/blog/${post.id}/`} class="post-card">
                {post.data.heroImage && <div class="card-image"><Image width={600} height={340} src={post.data.heroImage} alt={post.data.title} /></div>}
                <div class="card-content"><time class="card-date"><FormattedDate date={post.data.pubDate} /></time><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
              </a>
            ))}
          </div>
        </section>
      )}

      {startHere.length > 0 && (
        <section class="start-here">
          <div class="section-heading"><div><p class="section-eyebrow">Start here</p><h2>Worth reading next</h2></div><p>Evergreen pieces that are a good way into The Wrist Journal.</p></div>
          <div class="start-list">
            {startHere.map((post) => post && <a href={`/blog/${post.id}/`}><strong>{post.data.title}</strong><span>{post.data.description}</span></a>)}
          </div>
        </section>
      )}

      <section class="about-snippet">
        <h2>Your Trusted Indian Watch Community</h2>
        <p>The Wrist Journal is built for the growing community of watch collectors in India. Whether you are hunting for a first everyday watch or researching the next addition to your collection, the aim is simple: useful recommendations with an Indian buyer's perspective.</p>
        <a href="/about">Learn more about our watch journey →</a>
      </section>
    </main>
    <Footer />

    <style>
      main { width: 100%; max-width: 960px; padding: 0 1.5em 3em; }
      .hero { text-align: center; padding: 4em 0 3.5em; }
      .hero-eyebrow,.section-eyebrow { font-size: .78rem; color: var(--accent); font-weight: 600; margin: 0 0 .5em; letter-spacing: .06em; text-transform: uppercase; }
      .hero h1 { font-size: 3.5rem; margin-bottom: .45em; background: linear-gradient(135deg,var(--text),var(--accent)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
      .hero-subtitle { font-size: 1.15rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto 1.7em; line-height: 1.6; }
      .hero-actions { display: flex; justify-content: center; align-items: center; gap: 1.2em; flex-wrap: wrap; }
      .cta-button { display: inline-block; padding: .85em 1.6em; background: var(--accent); color: white; font-weight: 600; border-radius: var(--radius); text-decoration: none; }
      .cta-button:hover { background: var(--accent-hover); color: white; }
      .secondary-link { font-weight: 600; font-size: .95rem; }
      .discovery-section,.latest-posts,.start-here { padding: 2.5em 0; border-top: 1px solid var(--border); }
      .discovery-section.compact { padding-top: 2em; }
      .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2em; margin-bottom: 1.4em; }
      .section-heading h2 { margin: 0; }
      .section-heading > p { max-width: 360px; color: var(--text-secondary); font-size: .9rem; margin: 0; }
      .budget-grid { display: grid; grid-template-columns: repeat(5,1fr); gap: .75em; }
      .discovery-card { display: flex; min-height: 90px; flex-direction: column; justify-content: space-between; padding: 1em; border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: inherit; background: var(--bg-card); }
      .discovery-card:hover,.category-card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-md); color: inherit; }
      .discovery-card span { font-weight: 700; }
      .discovery-card small { color: var(--accent); font-weight: 600; }
      .category-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: .75em; }
      .category-card { display: flex; flex-direction: column; gap: .45em; padding: 1.15em; border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: inherit; background: var(--bg-card); }
      .category-card span { color: var(--accent); font-size: .82rem; font-weight: 600; }
      .posts-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5em; }
      .post-card { display: flex; flex-direction: column; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; text-decoration: none; color: inherit; }
      .post-card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-lg); transform: translateY(-2px); color: inherit; }
      .card-image { overflow: hidden; aspect-ratio: 16/9; }
      .card-image img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
      .card-content { padding: 1.15em; }
      .card-date { font-size: .75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; }
      .card-content h3 { font-size: 1.15rem; margin: .4em 0; line-height: 1.3; }
      .card-content p { font-size: .88rem; color: var(--text-secondary); margin: 0; line-height: 1.5; }
      .start-list { display: grid; grid-template-columns: repeat(3,1fr); gap: .8em; }
      .start-list a { display: flex; flex-direction: column; gap: .45em; padding: 1.15em; border-radius: var(--radius); background: var(--bg-subtle); text-decoration: none; color: inherit; }
      .start-list a:hover { color: inherit; box-shadow: var(--shadow-md); }
      .start-list span { color: var(--text-secondary); font-size: .85rem; line-height: 1.45; }
      .about-snippet { padding: 3em 0 2em; border-top: 1px solid var(--border); }
      .about-snippet p { color: var(--text-secondary); max-width: 650px; line-height: 1.7; }
      .about-snippet a { font-weight: 600; font-size: .95rem; }
      @media (max-width: 800px) { .budget-grid { grid-template-columns: repeat(2,1fr); } .category-grid { grid-template-columns: repeat(2,1fr); } .posts-grid,.start-list { grid-template-columns: 1fr; } }
      @media (max-width: 640px) { .hero { padding: 3em 0 2.5em; } .hero h1 { font-size: 2.45rem; } .section-heading { display: block; } .section-heading > p { margin-top: .6em; } .budget-grid { grid-template-columns: 1fr 1fr; } }
    </style>
  </body>
</html>
